# ─── API 1 — Annonces service ───────────────────────────────────────────────
# MongoDB connection string for api1 (points to the db1 container)
MONGO_URL=mongodb://admin:password@db1:27017/?authSource=admin

# Name of the MongoDB database used by api1
MONGO_DB_NAME=annonces

# ─── API 2 — Auth & Messages service ────────────────────────────────────────
# MongoDB connection string for api2 (points to the db2 container)
# MONGO_URL=mongodb://admin:password@db2:27017/?authSource=admin

# Name of the MongoDB database used by api2
MONGO_DB_NAME=messagerie

# Redis connection string for api2 (queue/pub-sub)
REDIS_URL=redis://redis:6379

# ─── Shared ──────────────────────────────────────────────────────────────────
# Secret key used to sign and verify JWT tokens — change this in production
JWT_SECRET=change_this_to_a_long_random_secret

# ─── Databases ───────────────────────────────────────────────────────────────
# MongoDB root credentials (used by both db1 and db2 containers)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_this_password